filters:
  and:
    - publish == true
    - file.ext == "md"
    - '!file.inFolder("private")'
    - '!file.inFolder("templates")'
    - '!file.path.contains("Backups")'
    - '!file.path.contains("QOD Backup")'
    - '!file.name.contains("QOD Question Bank")'
    - type == "qod"
properties:
  file.name:
    displayName: Question
  course:
    displayName: Course
  topic:
    displayName: Topic
views:
  - type: cards
    name: All QODs
    order:
      - file.name
      - topic
      - course
    groupBy:
      property: topic
      direction: ASC
  - type: cards
    name: Math 10C
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 10C")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
  - type: cards
    name: Math 10-3
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 10-3")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
  - type: cards
    name: Math 20-1
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 20-1")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
  - type: cards
    name: Math 20-2
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 20-2")
    order: [file.name, topic]
