filters:
  and:
    - file.inFolder("Math/QOD Question Bank")
    - type == "qod"
properties:
  file.name:
    displayName: Question
  topic:
    displayName: Topic
  courses:
    displayName: Courses
views:
  - type: table
    name: All QODs
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
      - courses
  - type: table
    name: Math 10C
    filters:
      and:
        - contains(courses, "Math 10C")
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
  - type: table
    name: Math 20-1
    filters:
      and:
        - contains(courses, "Math 20-1")
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
  - type: table
    name: Math 20-2
    filters:
      and:
        - contains(courses, "Math 20-2")
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
  - type: table
    name: Math 20-3
    filters:
      and:
        - contains(courses, "Math 20-3")
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
  - type: table
    name: Math 30-1
    filters:
      and:
        - contains(courses, "Math 30-1")
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
  - type: table
    name: Math 30-2
    filters:
      and:
        - contains(courses, "Math 30-2")
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
  - type: table
    name: Math 31
    filters:
      and:
        - contains(courses, "Math 31")
    groupBy:
      property: topic
      direction: ASC
    order:
      - file.name
