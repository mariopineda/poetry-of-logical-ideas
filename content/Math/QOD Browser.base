  - type: cards
    name: Math 20-3
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 20-3")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
  - type: cards
    name: Math 30-1
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 30-1")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
  - type: cards
    name: Math 30-2
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 30-2")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
  - type: cards
    name: Math 30-3
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 30-3")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
  - type: cards
    name: Math 31
    filters:
      and:
        - list() == course
        - list().contains("Mathematics 31")
    order: [file.name, topic]
    groupBy: { property: topic, direction: ASC }
